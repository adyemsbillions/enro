{
    "expo": {
        "name": "Enro",
        "slug": "enro",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "app.enro.mobile"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#5B3DF5",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "app.enro.mobile"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-status-bar",
            "expo-secure-store",
            "expo-web-browser",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Enro needs your photos so you can upload task proof screenshots."
                }
            ]
        ],
        "scheme": "enro",
        "experiments": {
            "typedRoutes": true
        }
    }
}
